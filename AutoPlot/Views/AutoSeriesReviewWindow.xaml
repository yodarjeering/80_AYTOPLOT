<Window x:Class="AutoPlot.Views.AutoSeriesReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自動検出結果の確認"
        Width="980"
        Height="680"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=OkButton}"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Window.Resources>
        <Style x:Key="ReviewUtilityButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#546E7A"/>
            <Setter Property="BorderBrush" Value="#546E7A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
                Margin="0,0,12,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource AppSurfaceBrush}">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="採用する曲線を選択してください"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <ListBox Grid.Row="1" ItemsSource="{Binding Candidates}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Padding="4" Margin="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="{Binding SelectionSummary}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="すべて選択"
                            Style="{StaticResource ReviewUtilityButtonStyle}"
                            Command="{Binding SelectAllCommand}" Margin="0,0,8,0"/>
                    <Button Content="すべて解除"
                            Style="{StaticResource ReviewUtilityButtonStyle}"
                            Command="{Binding ClearAllCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="110" Height="40" Margin="0,0,8,0"
                    IsDefault="True" Click="OnOkClicked"/>
            <Button Content="Cancel" Width="110" Height="40"
                    IsCancel="True" Click="OnCancelClicked"/>
        </StackPanel>
    </Grid>
</Window>
